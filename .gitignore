yarn-error.log*

# Build output
# Compiled, bundled, and generated artifacts
dist/
build/

# Test coverage
# Reports generated by test runners
coverage/

# Editor and IDE
# Workspace settings specific to individual editors
.vscode/
.idea/

# OS-specific files
# Files created automatically by operating systems
.DS_Store
Thumbs.db
